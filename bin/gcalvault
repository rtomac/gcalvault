#!/usr/bin/env python3

import sys
from gcalvault import Gcalvault, GcalvaultError


def main():
    print(
        "WARNING: gcalvault is no longer maintained. For automated backups, see vdirsyncer "
        "(https://vdirsyncer.pimutils.org). For one-time exports, use Google Takeout "
        "(https://takeout.google.com).",
        file=sys.stderr,
    )
    try:
        Gcalvault().run(sys.argv[1:])
        return 0
    except GcalvaultError as e:
        print(f"gcalvault: {e}", file=sys.stderr)
        print("gcalvault: Run 'gcalvault --help' for more information", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
